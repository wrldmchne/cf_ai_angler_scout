{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cf-ai-fishing-guru",
	"main": "src/index.ts",
	"compatibility_date": "2026-02-08",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": "./public",
		"binding": "ASSETS"
	},
	"ai": {
		"binding": "AI"
	},
	"vectorize": [
		{
			"binding": "VECTOR_INDEX",
			"index_name": "angler-ledger"
		}
	],
	"workflows": [
		{
			"name": "fishing-workflow",
			"binding": "FISHING_WORKFLOW",
			"class_name": "FishingWorkflow"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "FISHING_MEMORY",
				"class_name": "FishingMemory"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_classes": [
				"FishingMemory"
			]
		}
	],
	"observability": {
		"enabled": true
	}
}